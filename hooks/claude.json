{
  "description": "Easy Paper checks specs in all four PDF modes and persona files after a write or edit.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/lint_spec.py\"", "timeout": 30 }
        ]
      }
    ]
  }
}
